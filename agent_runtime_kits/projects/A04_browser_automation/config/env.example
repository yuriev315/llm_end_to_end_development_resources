AGENT_BROWSER_MODE=mock
# mock | playwright
# Playwright 浏览器 zip 在 runtimes/<platform>/playwright_browsers/
# 需要按 Playwright 文档设置 PLAYWRIGHT_BROWSERS_PATH 后再安装/解压，本轮未执行。
PLAYWRIGHT_BROWSERS_PATH=../../../runtimes/linux_x86_64/playwright_browsers
# browser-use 仅 Python 3.12。不要在 3.10 venv 中安装。
AGENT_LLM_MODE=mock
AGENT_LLM_BASE_URL=http://127.0.0.1:8080/v1
